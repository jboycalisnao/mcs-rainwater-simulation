{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-build",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "allowImportingTsExtensions": false
  },
  "include": [
    "constants.ts",
    "types.ts",
    "services/**/*.ts",
    "tests/**/*.ts"
  ]
}
